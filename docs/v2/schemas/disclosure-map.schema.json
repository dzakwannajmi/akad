{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dzakwannajmi/akad/docs/v2/schemas/disclosure-map.schema.json",
  "title": "Akad disclosure map",
  "description": "What each circuit makes public and what it keeps private. The only allowed source for privacy claims.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contract", "sourceCommit", "circuits"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "circuits": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/circuit" }
    }
  },
  "$defs": {
    "circuit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "publicInputs", "ledgerReads", "ledgerWrites", "traderAddressPublished", "amountsVisible", "visible", "private", "evidence"],
      "properties": {
        "source": { "type": "string", "pattern": "^contracts/src/.+\\.compact#L[0-9]+-L[0-9]+$" },
        "publicInputs": { "type": "integer", "minimum": 0 },
        "ledgerReads": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "ledgerWrites": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "traderAddressPublished": { "type": "boolean" },
        "amountsVisible": { "enum": ["none", "exact", "size class", "inferable from reserve delta"] },
        "visible": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "private": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array", "items": { "type": "string", "pattern": "^E-[0-9]{2,3}$" }, "uniqueItems": true }
      }
    }
  }
}
