# Which network the toggle in the UI defaults to on first load (before the
# user picks one, and before anything is in localStorage). "preview" or
# "preprod".
NEXT_PUBLIC_DEFAULT_NETWORK=preview

NEXT_PUBLIC_AKAD_CONTRACT_PATH=/contracts/akad
NEXT_PUBLIC_PRIVATE_STATE_PASSWORD=akad-dev-only-password

# Preview network. Akad has run on Preview since the start of the project;
# these are safe to leave at the defaults below.
NEXT_PUBLIC_INDEXER_HTTP_PREVIEW=https://indexer.preview.midnight.network/api/v4/graphql
NEXT_PUBLIC_INDEXER_WS_PREVIEW=wss://indexer.preview.midnight.network/api/v4/graphql/ws
NEXT_PUBLIC_AKAD_CONTRACT_ADDRESS_PREVIEW=

# Preprod network. Deploy the contract fresh to Preprod via the /deploy
# page (use the network switcher there to pick Preprod, with a
# Preprod-funded wallet), then paste the resulting contract address below.
# Leaving NEXT_PUBLIC_AKAD_CONTRACT_ADDRESS_PREPROD empty is fine -- the
# Preprod option still shows in the UI, it just has nothing to call yet.
NEXT_PUBLIC_INDEXER_HTTP_PREPROD=https://indexer.preprod.midnight.network/api/v4/graphql
NEXT_PUBLIC_INDEXER_WS_PREPROD=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
NEXT_PUBLIC_AKAD_CONTRACT_ADDRESS_PREPROD=

# Server-side only (no NEXT_PUBLIC_ prefix): back the shared activity feed
# in app/api/activity/route.ts. This key bypasses row-level security,
# never expose it to the client or commit it.
#
# SUPABASE_URL: Project Settings > API Keys > Project URL.
# SUPABASE_SECRET_KEY: Project Settings > API Keys > "Secret keys" tab
# (Supabase's new key system, looks like sb_secret_...). If your project
# still shows the old anon/service_role pair instead, use the
# service_role key here (same variable name works either way).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
