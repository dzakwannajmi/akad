NEXT_PUBLIC_NETWORK_ID=preview
NEXT_PUBLIC_INDEXER_HTTP=https://indexer.preview.midnight.network/api/v4/graphql
NEXT_PUBLIC_INDEXER_WS=wss://indexer.preview.midnight.network/api/v4/graphql/ws
NEXT_PUBLIC_AKAD_CONTRACT_PATH=/contracts/akad
NEXT_PUBLIC_PRIVATE_STATE_PASSWORD=akad-dev-only-password
NEXT_PUBLIC_AKAD_CONTRACT_ADDRESS=

# Server-side only (no NEXT_PUBLIC_ prefix): back the shared activity feed
# in app/api/activity/route.ts. This key bypasses row-level security,
# never expose it to the client or commit it.
#
# SUPABASE_URL: Project Settings > API Keys > Project URL.
# SUPABASE_SECRET_KEY: Project Settings > API Keys > "Secret keys" tab
# (Supabase's new key system, looks like sb_secret_...). If your project
# still shows the old anon/service_role pair instead, use the
# service_role key here (same variable name works either way).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
