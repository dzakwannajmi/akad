# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/tsconfig.tsbuildinfo

# Environment secrets, including the CLI's automation wallet seeds in
# .env.automation. Only .env.example files, which hold variable names, are
# committed.
.env
.env.*
!.env.example

# CLI wallet sync cache: no keys, but it reveals which coins a wallet owns.
.akad-cache/

# Compact compile output (large binary artifacts; regenerate via `compact compile`)
build/

# OS/editor cruft
.DS_Store
*.log
.vscode/

# Files the Claude desktop app drops into this folder when it delivers
# generated files during a chat session -- not meant to be versioned.
Claude outputs/

# Claude Code project config and skills installed via `npx skills add`
# -- local tooling, not part of the product.
.claude/
skills-lock.json

# Claude Code operating notes. Plans and working docs live under .claude/,
# ignored above; docs/v2/ holds only final documents, schemas and evidence.
CLAUDE.md
