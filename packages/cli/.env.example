# Variable names the CLI reads. Do not fill this file in: `akad wallet create
# --name aN` writes each seed to .env.automation at the repository root
# (mode 0600, ignored by git), and the CLI loads that file itself.
AKAD_SEED_A0=
AKAD_SEED_A1=
AKAD_SEED_A2=

# Per-transaction fee cap in DUST base units. Required for any command run
# with --yes; there is no default.
AKAD_MAX_FEE_DUST=
