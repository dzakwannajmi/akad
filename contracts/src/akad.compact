pragma language_version >= 0.23.0;

import CompactStandardLibrary;

// Akad: privacy-optional constant-product AMM (x * y = k) for AKD <-> tNIGHT
// on Midnight. This single contract replaces the earlier two-contract split
// (token.compact + swap.compact): swap circuits now move real AKD balances
// directly, which requires them to share this contract's own balances map
// rather than call into a separately deployed contract. Compact has no
// verified-safe pattern for authorizing a cross-contract balance debit
// (see docs/TROUBLESHOOTING.md for the investigation), so merging into one
// contract was the safer path.
//
// Caller identity is bound to the wallet's real Zswap public key
// (ownPublicKey()) rather than a self-declared witness, closing a spoofing
// gap present in the previous token.compact, where any client could supply
// an arbitrary accountKey with no on-chain verification.
//
// tNIGHT settlement is real on the public swap path: swapAkdToNight() pays
// the trader out of the pool's own native-token custody via sendUnshielded,
// swapNightToAkd() takes the trader's tNIGHT into that same custody via
// receiveUnshielded, and addLiquidity() funds the pool's initial tNIGHT
// custody the same way. All three use nativeToken() as the color, since
// this contract cannot mint real tNIGHT, only move tNIGHT that already
// exists in a wallet.
//
// Both swap paths settle tNIGHT for real. sendUnshielded/receiveUnshielded
// are transparent by design: the amount and the counterparty address land
// on-chain in the clear. That is an accepted and documented cost, not
// something this contract pretends to hide. An earlier version of the two
// private circuits below left the tNIGHT leg out entirely to avoid that
// exposure, which meant privateSwapAkdToNight took a trader's real AKD and
// paid nothing back, while privateSwapNightToAkd minted real AKD without
// ever receiving tNIGHT. Both are fixed here: a documented privacy
// tradeoff is not a reason to ship a circuit that moves value one way.
//
// A tNIGHT leg that is both real and private would need a genuinely
// shielded representation of the native token, which this contract has no
// way to create (minting only works for a color this contract owns, not
// the network's native token). Left as an open research question, not
// solved here -- see README roadmap.
//
// privateSwapAkdToNight / privateSwapNightToAkd let a trader spend or
// receive the AKD leg of a swap as a shielded coin directly, instead of
// going through a public balances entry (wrap -> public swap -> unwrap).
// Their wallet identity never touches the `balances` map for that trade.
//
// Coin material (the mint nonce, and the whole ShieldedCoinInfo of a coin
// being spent) comes from the two witnesses declared below, never from a
// circuit argument.
//
// Be precise about why, because this project got it wrong once already. An
// earlier version of this comment said that taking `nonce` as an argument
// published it in the clear, so an observer could link a coin to the wallet
// that wrapped it by matching nonces. That was tested against every
// transaction of a live pre-refactor deployment and is false: the nonce
// appears in none of them, while a control value known to be present was
// found every time. An on-chain ContractCall carries no argument list;
// arguments are bound through a randomised communication commitment. See
// hackathon/SECURITY_AUDIT.md, "H-02 refuted on chain".
//
// What the witnesses actually buy is narrower, and is hardening rather than
// a fix: fewer public inputs to each proof (wrap 3 to 1, unwrap 5 to 0,
// measurable with scripts/zk-public-inputs.mjs), no reliance on coin
// material supplied by the caller, and no argument list through which a
// frontend defect could leak it.
//
// The real identity leak on the private path is elsewhere and is not
// addressed by any of this: sendUnshielded and receiveUnshielded publish
// the trader's unshielded address and the amount in the clear, which any
// block explorer renders without decoding anything.
//
// Both circuits assert coin.color == tokenColor before accepting a
// shielded coin as input, closing a gap unwrap() had: receiveShielded()
// only verifies a coin is authentic and unspent, not which token it is,
// so without that check any wallet could "unwrap" a shielded coin of a
// different color/type and still be credited 1:1 as AKD.

// Private inputs. These are the contract's only witnesses, and they exist
// specifically so that coin material never reaches the public transcript.
//
// coinNonce() supplies the randomness for a coin this contract is about to
// mint (wrap, privateSwapNightToAkd). It must be fresh for every call: a
// reused nonce produces a coin the Zswap layer will refuse as a duplicate
// commitment, and would reintroduce exactly the linkability this witness
// exists to remove.
//
// spentCoin() supplies the coin this contract is about to receive (unwrap,
// privateSwapAkdToNight). The caller's wallet holds the coin; the circuit
// proves, without publishing it, that the coin is the right colour and
// then hands it to receiveShielded(), which enforces authenticity and
// unspent-ness at the protocol layer.
//
// Both are marked disclose() at their use sites. In Compact, disclose() is
// an acknowledgement demanded by the compiler's information-flow analysis,
// not a publication: the compiler flags that a coin commitment is a hash
// of the witness value and therefore *could* link a spend to a mint for
// anyone who already knows the value. The witness value itself stays out
// of the proof's public inputs, which is verifiable in the generated zkir.
witness coinNonce(): Bytes<32>;
witness spentCoin(): ShieldedCoinInfo;

// AKD balance ledger: maps an account identifier to its public AKD balance.
export ledger balances: Map<Bytes<32>, Uint<128>>;
export ledger totalSupply: Uint<128>;
export ledger tokenColor: Bytes<32>;

// The faucet's custody account bytes, written once by init() so the
// frontend can read it directly from ledger state (the same way it already
// reads tokenColor) instead of needing a transaction just to look up an
// address, or reimplementing persistentHash() in TypeScript.
export ledger faucetAddress: Bytes<32>;

// AMM reserves (constant-product pool, AKD <-> tNIGHT).
export ledger reserveAKD: Uint<128>;
export ledger reserveNight: Uint<128>;

// sNIGHT: this contract's shielded receipt for tNIGHT it holds in custody,
// backed 1:1. It exists because tNIGHT itself can never be private. From
// Midnight's own token documentation: "NIGHT is an unshielded token: its
// balances and transfers are always public, and holding NIGHT at a shielded
// address does not make it private."
//
// That sentence is the whole reason this token exists. An earlier version of
// this contract offered "private" swaps whose tNIGHT leg used sendUnshielded
// and receiveUnshielded, which publish the trader's unshielded address in the
// clear. Verified on Preprod: both directions named the trader, with the same
// address in each, so the two trades were linkable to one wallet by anyone
// opening a block explorer. No amount of care inside the circuit could fix
// that, because the transparency is a property of the token, not the code.
//
// So the pairing changes instead. Trades run shielded AKD against shielded
// sNIGHT, and no address appears in a swap at all. Transparency moves to the
// boundary: wrapNight() and unwrapNight() are visible, the trades between
// them are not. That is how a shielded pool is supposed to work, and the
// anonymity set is everyone who has wrapped tNIGHT.
//
// The honest cost: sNIGHT is a claim on this contract, not tNIGHT itself,
// the same way WETH is not ETH. It is only as good as the custody backing it.
//
// Solvency invariant, maintained by every circuit below:
//
//     tNIGHT held in custody  ==  reserveNight + sNightSupply
//
//   wrapNight(v)            custody +v, sNightSupply +v, reserveNight  0
//   unwrapNight(v)          custody -v, sNightSupply -v, reserveNight  0
//   shieldedSwapAkdToNight  custody  0, sNightSupply +dy, reserveNight -dy
//   shieldedSwapNightToAkd  custody  0, sNightSupply -dx, reserveNight +dx
//   addLiquidity(v)         custody +v, sNightSupply  0, reserveNight +v
//
// Every sNIGHT in existence is therefore covered by custody that no reserve
// also claims. unwrapNight() still asserts custody explicitly rather than
// trusting the invariant, because an accounting bug should fail a redemption
// rather than silently spend the pool's own reserve.
export ledger sNightColor: Bytes<32>;
export ledger sNightSupply: Uint<128>;

// Tracks which accounts have already claimed from the public faucet, so
// each wallet can only bootstrap AKD once. A per-wallet limit rather than
// a per-time-window one, since Compact circuits have no verified-safe way
// to read wall-clock time for a cooldown.
export ledger faucetClaimed: Map<Bytes<32>, Boolean>;

// Returns the real, wallet-bound identity of whoever is calling this
// transaction right now. Replaces the old self-declared accountKey()
// witness, which any client could set to an arbitrary value with no
// on-chain verification.
circuit callerKey(): Bytes<32> {
  return disclose(ownPublicKey().bytes);
}

// Fixed account identifier the pool itself uses to custody AKD it holds as
// swap/liquidity reserves. Derived the same way tokenColor is (a
// persistentHash of a small domain-separation constant), so it cannot
// collide with any real ownPublicKey()-derived account key.
circuit poolKey(): Bytes<32> {
  return persistentHash<Uint<8>>(7);
}

// Fixed account identifier for the public faucet's own AKD custody,
// separate from the pool's. There is no dedicated funding circuit: the
// builder tops this account up using the existing transfer() circuit,
// passing the ledger's faucetAddress value as the recipient, the same
// way any other account would be credited.
circuit faucetKey(): Bytes<32> {
  return persistentHash<Uint<8>>(11);
}

// AKD's shielded token type ("colour"), derived from a fixed domain
// separator and this contract's own address.
//
// This MUST be computed inside a circuit. kernel.self() does not return the
// deployed contract's address when it runs in a constructor, so a colour
// derived there is identical for every deployment and never matches what
// mintShieldedToken() stamps on a coin at circuit runtime. Confirmed on a
// live Preprod deployment: the constructor stored
// 41be7ea9e356e3caff7d27d1f36b7074581c009063450e1a5d3da25c4566a888 while a
// real wrap() on that same contract minted a coin coloured
// cae5ab8a811a7aeb0bc6d9f9744c57226d48752de4953a0d613e51f14c68da3f. Every
// consumer of the colour goes through this helper so the two can never
// drift apart again.
circuit currentTokenColor(): Bytes<32> {
  const domainSep: Bytes<32> = persistentHash<Uint<8>>(42);
  return tokenType(domainSep, kernel.self());
}

// sNIGHT's shielded token type, derived exactly like AKD's but under a
// different domain separator, so the two colours can never collide and a
// coin of one can never be accepted where the other is expected. Same
// constructor caveat as currentTokenColor(): kernel.self() must be read
// inside a circuit, never in the constructor.
circuit currentNightColor(): Bytes<32> {
  const domainSep: Bytes<32> = persistentHash<Uint<8>>(43);
  return tokenType(domainSep, kernel.self());
}

// Safe balance read. `balances` only gets a map entry for an account once
// that account has been credited at least once (init, transfer, unwrap, or
// a swap). Calling Map.lookup() on a key with no entry yet fails at
// runtime ("expected a cell, received null") instead of returning a
// default, so every balance read in this contract goes through this
// helper rather than calling balances.lookup() directly. Same pattern
// OpenZeppelin's own FungibleToken.compact uses for balanceOf().
circuit balanceOf(account: Bytes<32>): Uint<128> {
  if (!balances.member(account)) {
    return 0;
  }
  return balances.lookup(account);
}

// Safe read for faucetClaimed, same member-check-then-default pattern as
// balanceOf() above (verified against OpenZeppelin's own
// AccessControl.compact _hasRole(), which reads a Map<..., Boolean> the
// same way).
circuit hasClaimedFaucet(account: Bytes<32>): Boolean {
  if (!faucetClaimed.member(account)) {
    return false;
  }
  return faucetClaimed.lookup(account);
}

// Mints the initial supply to the deployer, as part of the deploy
// transaction itself. This replaces a separate init() circuit that was
// guarded only by `assert(totalSupply.read() == 0)`. On Midnight, deploy
// and the first circuit call are separate transactions, so that guard
// left a window in which anyone watching new deployments could call
// init() first and receive the entire supply. A constructor closes the
// window completely: there is no callable entry point to race.
constructor() {
  const owner = callerKey();

  // 1,000,000 AKD at 6 decimals = 1_000_000_000_000 base units
  balances.insert(owner, 1000000000000);
  totalSupply.write(1000000000000);

  // faucetKey() is a plain hash of a constant, so it is safe to derive
  // here. tokenColor is not: see currentTokenColor() above. It is written
  // by recordTokenColor() instead.
  faucetAddress.write(disclose(faucetKey()));
}

// Transfers AKD from the caller to a recipient.
export circuit transfer(to: Bytes<32>, amount: Uint<128>): [] {
  const sender = callerKey();
  const senderBalance = balanceOf(sender);

  assert(senderBalance >= amount, "insufficient balance");

  const newSenderBalance: Uint<128> = (senderBalance - amount) as Uint<128>;
  balances.insert(sender, disclose(newSenderBalance));

  const recipientBalance = balanceOf(disclose(to));
  const newRecipientBalance: Uint<128> = (recipientBalance + amount) as Uint<128>;
  balances.insert(disclose(to), disclose(newRecipientBalance));
}

// Lets any wallet that has never held AKD before bootstrap a small fixed
// amount (50 AKD -- 50_000_000 base units at this token's 6 decimals) so
// it can try a real swap without the builder manually transferring tokens
// to it first. One-time per wallet: see faucetClaimed / hasClaimedFaucet()
// above. The faucet's own balance is funded by the builder via transfer(),
// passing the ledger's faucetAddress value as the recipient. It can run
// dry, and callers get a clear assert message when it does rather than a
// generic balance failure.
export circuit claimFaucet(): [] {
  const caller = callerKey();
  assert(!hasClaimedFaucet(caller), "this wallet has already claimed from the faucet");

  const faucet = faucetKey();
  const faucetBalance = balanceOf(faucet);
  assert(faucetBalance >= 50000000, "faucet is empty, ask the deployer to top it up");

  const newFaucetBalance: Uint<128> = (faucetBalance - 50000000) as Uint<128>;
  balances.insert(faucet, disclose(newFaucetBalance));

  const callerBalance = balanceOf(caller);
  const newCallerBalance: Uint<128> = (callerBalance + 50000000) as Uint<128>;
  balances.insert(caller, disclose(newCallerBalance));

  faucetClaimed.insert(caller, true);
}

// akdColor() used to live here: an exported circuit that returned
// currentTokenColor() and nothing else. It was removed, for two reasons.
// Nothing ever called it (the frontend reads the colour from ledger state,
// which costs no transaction at all), and every exported circuit carries a
// verifier key in the deploy transaction, which Midnight's block limits
// make a real budget. See the note above recordTokenColor() for why an
// unused circuit is not free. Audit finding I-04.

// Records both shielded token types into ledger state, so the frontend can
// read it straight from public state instead of paying for a transaction.
//
// Deliberately has no access control and no one-shot guard. The value is a
// pure function of this contract's address and a fixed domain separator, so
// every caller writes byte-identical data: there is nothing to gain by
// front-running this and nothing to corrupt by repeating it.
//
// Correctness never depends on this having been called. unwrap() and
// privateSwapAkdToNight() compute the colour themselves through
// currentTokenColor() rather than trusting this field, so an unrecorded or
// stale ledger value can cost a caller a wasted read, never a wrong coin.
export circuit recordTokenColor(): [] {
  tokenColor.write(disclose(currentTokenColor()));
  sNightColor.write(disclose(currentNightColor()));
}

// Wrap: lock public AKD balance, mint the same amount as a native shielded
// coin sent to the caller. 1:1 backed, single conservation invariant.
// `amount` stays a public argument on purpose: this circuit debits a
// public `balances` entry, so the amount is already recoverable from the
// ledger delta. Hiding it in the signature while publishing it in the
// write would be theatre. The nonce is the value that genuinely can be
// hidden, and it is.
export circuit wrap(amount: Uint<128>): [] {
  const caller = callerKey();
  const balance = balanceOf(caller);

  assert(balance >= amount, "insufficient balance to wrap");
  assert(amount > 0, "amount must be positive");
  assert(amount <= 18446744073709551615, "amount exceeds shielded mint bound (Uint<64>)");

  const newBalance: Uint<128> = (balance - amount) as Uint<128>;
  balances.insert(caller, disclose(newBalance));

  const domainSep: Bytes<32> = persistentHash<Uint<8>>(42);
  const value: Uint<64> = disclose(amount as Uint<64>);
  const recipient = left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey());

  const coin = mintShieldedToken(domainSep, value, disclose(coinNonce()), recipient);
}

// Unwrap: receive a shielded AKD coin back into the contract, credit the
// same amount to the caller's public balance. 1:1 backed, same invariant.
//
// Takes no arguments at all. The coin comes from the spentCoin() witness,
// which leaves this circuit with zero public inputs to its proof: nothing
// about which coin was spent is published. What the transaction does
// reveal is the caller's own balance write, so the amount is still
// inferable from the ledger delta, same as wrap.
export circuit unwrap(): [] {
  const coin = spentCoin();
  assert(coin.color == currentTokenColor(), "wrong token color");
  receiveShielded(disclose(coin));

  const caller = callerKey();
  const balance = balanceOf(caller);
  const amount: Uint<128> = coin.value;
  const newBalance: Uint<128> = (balance + amount) as Uint<128>;

  balances.insert(caller, disclose(newBalance));
}

// Seeds the pool's initial liquidity. Can only be called once (single fixed
// liquidity from the builder, no LP tokens, keeps attack surface minimal
// for this scope; see README roadmap for future multi-provider support).
// Moves the builder's real AKD balance into the pool's own custody account.
export circuit addLiquidity(amountAKD: Uint<128>, amountNight: Uint<128>): [] {
  const x = reserveAKD.read();
  const y = reserveNight.read();

  assert(x == 0 && y == 0, "liquidity already seeded");
  assert(amountAKD > 0 && amountNight > 0, "amounts must be positive");
  // Bound tightened from the previous 1e18 to 4_000_000_000: sqrt(Uint<64>::MAX)
  // is ~4_294_967_295, so the invariant check in the swap circuits below can
  // overflow past that. 4e9 keeps (x+dx)*(y-dy) safely under Uint<64>::MAX
  // even at the ceiling on both sides.
  assert(amountAKD <= 4000000000, "amountAKD exceeds safe bound");
  assert(amountNight <= 4000000000, "amountNight exceeds safe bound");

  const builder = callerKey();
  const builderBalance = balanceOf(builder);
  assert(builderBalance >= amountAKD, "insufficient AKD balance to seed pool");

  const newBuilderBalance: Uint<128> = (builderBalance - amountAKD) as Uint<128>;
  balances.insert(builder, disclose(newBuilderBalance));

  const pool = poolKey();
  const poolBalance = balanceOf(pool);
  const newPoolBalance: Uint<128> = (poolBalance + amountAKD) as Uint<128>;
  balances.insert(pool, disclose(newPoolBalance));

  // Pull the matching tNIGHT amount into the pool's own on-chain custody --
  // a real native-token balance, not just a ledger number. This only
  // declares the contract's intent to receive it; the wallet's own
  // transaction-balancing step sources the actual tNIGHT from the
  // builder's wallet.
  receiveUnshielded(nativeToken(), disclose(amountNight));

  reserveAKD.write(disclose(amountAKD));
  reserveNight.write(disclose(amountNight));
}

// Swap AKD -> tNIGHT. Both legs are real: dx moves from the trader's AKD
// balance into the pool's custody, and dy is paid out of the pool's own
// tNIGHT custody straight to the trader's wallet via sendUnshielded.
// `recipient` must be the caller's own unshielded address (UserAddress) --
// sendUnshielded needs a concrete destination; unlike receiveShielded /
// receiveUnshielded, there is no "pay whoever's calling" primitive.
export circuit swapAkdToNight(dx: Uint<128>, dy: Uint<128>, minOut: Uint<128>, recipient: UserAddress): [] {
  const x = reserveAKD.read();
  const y = reserveNight.read();

  assert(x > 0 && y > 0, "pool not initialized");
  assert(dx > 0, "amount must be positive");
  assert(dy > 0, "output rounds to zero");
  assert(dy >= minOut, "slippage: insufficient output");
  assert(dy < y, "cannot drain full reserve");
  assert(x + dx <= 4000000000, "reserveAKD exceeds safe bound");
  assert(y <= 4000000000, "reserveNight exceeds safe bound");
  assert(unshieldedBalanceGte(nativeToken(), disclose(dy)), "pool has insufficient tNIGHT custody for this swap");

  const xBig: Uint<64> = x as Uint<64>;
  const dxBig: Uint<64> = dx as Uint<64>;
  const yBig: Uint<64> = y as Uint<64>;
  const dyBig: Uint<64> = dy as Uint<64>;

  assert((xBig + dxBig) * (yBig - dyBig) >= xBig * yBig, "invalid swap: violates constant product invariant");

  const trader = callerKey();
  const traderBalance = balanceOf(trader);
  assert(traderBalance >= dx, "insufficient AKD balance for swap");

  const newTraderBalance: Uint<128> = (traderBalance - dx) as Uint<128>;
  balances.insert(trader, disclose(newTraderBalance));

  const pool = poolKey();
  const poolBalance = balanceOf(pool);
  const newPoolBalance: Uint<128> = (poolBalance + dx) as Uint<128>;
  balances.insert(pool, disclose(newPoolBalance));

  reserveAKD.write(disclose((x + dx) as Uint<128>));
  reserveNight.write(disclose((y - dy) as Uint<128>));

  sendUnshielded(nativeToken(), disclose(dy), right<ContractAddress, UserAddress>(disclose(recipient)));
}

// Swap tNIGHT -> AKD. Both legs are real: dx moves the trader's tNIGHT
// into the pool's own native-token custody via receiveUnshielded, and dy
// moves from the pool's AKD custody to the trader's balance.
export circuit swapNightToAkd(dx: Uint<128>, dy: Uint<128>, minOut: Uint<128>): [] {
  const x = reserveNight.read();
  const y = reserveAKD.read();

  assert(x > 0 && y > 0, "pool not initialized");
  assert(dx > 0, "amount must be positive");
  assert(dy > 0, "output rounds to zero");
  assert(dy >= minOut, "slippage: insufficient output");
  assert(dy < y, "cannot drain full reserve");
  assert(x + dx <= 4000000000, "reserveNight exceeds safe bound");
  assert(y <= 4000000000, "reserveAKD exceeds safe bound");

  const xBig: Uint<64> = x as Uint<64>;
  const dxBig: Uint<64> = dx as Uint<64>;
  const yBig: Uint<64> = y as Uint<64>;
  const dyBig: Uint<64> = dy as Uint<64>;

  assert((xBig + dxBig) * (yBig - dyBig) >= xBig * yBig, "invalid swap: violates constant product invariant");

  const pool = poolKey();
  const poolBalance = balanceOf(pool);
  assert(poolBalance >= dy, "pool has insufficient AKD custody for this swap");

  // Pull the trader's real tNIGHT into the pool's custody. Checked after
  // the custody assert above, so a failing check cannot take the trader's
  // tNIGHT without delivering AKD. This only declares the contract's
  // intent to receive it; the wallet's own transaction-balancing step
  // sources it from the trader's wallet.
  receiveUnshielded(nativeToken(), disclose(dx));

  const newPoolBalance: Uint<128> = (poolBalance - dy) as Uint<128>;
  balances.insert(pool, disclose(newPoolBalance));

  const trader = callerKey();
  const traderBalance = balanceOf(trader);
  const newTraderBalance: Uint<128> = (traderBalance + dy) as Uint<128>;
  balances.insert(trader, disclose(newTraderBalance));

  reserveNight.write(disclose((x + dx) as Uint<128>));
  reserveAKD.write(disclose((y - dy) as Uint<128>));
}

// ---------------------------------------------------------------------------
// sNIGHT boundary: the only two circuits on the shielded path that are
// deliberately transparent. Entering and leaving the pool is visible; what
// happens between is not.
// ---------------------------------------------------------------------------

// wrapNight() used to live here: it took tNIGHT into custody via
// receiveUnshielded and minted the caller an sNIGHT coin directly. It was
// removed to stay inside Midnight's deploy-transaction block limits, which
// surface on contracts with roughly ten or more non-trivial circuits. This
// was the cheapest circuit to lose, because it is the only one whose job
// another circuit already does.
//
// sNIGHT still enters circulation, just through the pool rather than beside
// it: shieldedSwapAkdToNight() mints it against reserveNight. The full round
// trip is unaffected, claim AKD, wrap it, swap to sNIGHT, swap back to a
// shielded AKD coin, unwrap. And unwrapNight() below is deliberately kept,
// because a receipt nobody can redeem is not a receipt. sNIGHT remains a 1:1
// claim on real tNIGHT that any holder can exit at will.
//
// What is lost is the direct entry path for someone holding only tNIGHT.
// They can still reach the shielded side, through the public swap first.
//
// The solvency invariant is unchanged. sNIGHT now originates only from
// reserveNight, which addLiquidity funded with real tNIGHT, so custody still
// covers every outstanding coin.

// Redeem a shielded sNIGHT coin for real tNIGHT.
//
// `recipient` is required because sendUnshielded needs a concrete
// destination, and it is published. Same trade as wrapNight: leaving the pool
// is visible, and it does not reveal which trades the coin passed through.
//
// The custody assertion runs before receiveShielded() claims the coin, so a
// contract that cannot pay can never swallow the coin first.
export circuit unwrapNight(recipient: UserAddress): [] {
  const coin = spentCoin();
  assert(coin.color == currentNightColor(), "wrong token color");

  const amount: Uint<128> = coin.value;
  assert(amount > 0, "amount must be positive");

  const supply = sNightSupply.read();
  assert(supply >= amount, "sNIGHT supply accounting underflow");
  assert(unshieldedBalanceGte(nativeToken(), disclose(amount)), "contract has insufficient tNIGHT custody to redeem this coin");

  receiveShielded(disclose(coin));

  sNightSupply.write(disclose((supply - amount) as Uint<128>));

  sendUnshielded(nativeToken(), disclose(amount), right<ContractAddress, UserAddress>(disclose(recipient)));
}

// ---------------------------------------------------------------------------
// Shielded swaps: shielded coin in, shielded coin out, no address anywhere.
//
// These replace privateSwapAkdToNight and privateSwapNightToAkd, which were
// removed rather than kept alongside. Those circuits published the trader's
// unshielded address on every call, and a toggle labelled "private" that
// names you is worse than no toggle at all.
//
// What is still public here, stated plainly so nobody mistakes these for
// anonymous: the reserves are public, so the trade size is recoverable from
// the reserve delta. That is structural to a constant-product AMM, which
// cannot price a trade without public reserves, and it is true on every
// chain. What these circuits remove is the trader's identity, not the amount.
// ---------------------------------------------------------------------------

// Shielded AKD in, shielded sNIGHT out.
//
// dx is the spent coin's own value rather than a caller-supplied parameter,
// so it cannot be claimed independently of what is actually being spent.
// Every assertion runs before receiveShielded() claims the coin.
export circuit shieldedSwapAkdToNight(dy: Uint<128>, minOut: Uint<128>): [] {
  const coin = spentCoin();
  assert(coin.color == currentTokenColor(), "wrong token color");

  const dx: Uint<128> = coin.value;
  assert(dx > 0, "amount must be positive");

  const x = reserveAKD.read();
  const y = reserveNight.read();

  assert(x > 0 && y > 0, "pool not initialized");
  assert(dy > 0, "output rounds to zero");
  assert(dy >= minOut, "slippage: insufficient output");
  assert(dy < y, "cannot drain full reserve");
  assert(x + dx <= 4000000000, "reserveAKD exceeds safe bound");
  assert(y <= 4000000000, "reserveNight exceeds safe bound");

  const xBig: Uint<64> = x as Uint<64>;
  const dxBig: Uint<64> = dx as Uint<64>;
  const yBig: Uint<64> = y as Uint<64>;
  const dyBig: Uint<64> = dy as Uint<64>;

  assert((xBig + dxBig) * (yBig - dyBig) >= xBig * yBig, "invalid swap: violates constant product invariant");

  receiveShielded(disclose(coin));

  const pool = poolKey();
  const poolBalance = balanceOf(pool);
  const newPoolBalance: Uint<128> = (poolBalance + dx) as Uint<128>;
  balances.insert(pool, disclose(newPoolBalance));

  // dx becomes public here, unavoidably: the reserve delta IS the trade size
  // on any public-reserve AMM. The identity behind it does not.
  reserveAKD.write(disclose((x + dx) as Uint<128>));
  reserveNight.write(disclose((y - dy) as Uint<128>));

  // dy moves out of the pool's share of custody and into a redeemable coin.
  // Custody itself is unchanged, so the solvency invariant holds.
  const supply = sNightSupply.read();
  sNightSupply.write(disclose((supply + dy) as Uint<128>));

  // dy < y <= 4_000_000_000, so the Uint<64> downcast is already bounded.
  const domainSep: Bytes<32> = persistentHash<Uint<8>>(43);
  const value: Uint<64> = disclose(dy as Uint<64>);
  const out = mintShieldedToken(domainSep, value, disclose(coinNonce()), left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey()));
}

// Shielded sNIGHT in, shielded AKD out. Mirror of the circuit above.
export circuit shieldedSwapNightToAkd(dy: Uint<128>, minOut: Uint<128>): [] {
  const coin = spentCoin();
  assert(coin.color == currentNightColor(), "wrong token color");

  const dx: Uint<128> = coin.value;
  assert(dx > 0, "amount must be positive");

  const x = reserveNight.read();
  const y = reserveAKD.read();

  assert(x > 0 && y > 0, "pool not initialized");
  assert(dy > 0, "output rounds to zero");
  assert(dy >= minOut, "slippage: insufficient output");
  assert(dy < y, "cannot drain full reserve");
  assert(x + dx <= 4000000000, "reserveNight exceeds safe bound");
  assert(y <= 4000000000, "reserveAKD exceeds safe bound");

  const xBig: Uint<64> = x as Uint<64>;
  const dxBig: Uint<64> = dx as Uint<64>;
  const yBig: Uint<64> = y as Uint<64>;
  const dyBig: Uint<64> = dy as Uint<64>;

  assert((xBig + dxBig) * (yBig - dyBig) >= xBig * yBig, "invalid swap: violates constant product invariant");

  const pool = poolKey();
  const poolBalance = balanceOf(pool);
  assert(poolBalance >= dy, "pool has insufficient AKD custody for this swap");

  const supply = sNightSupply.read();
  assert(supply >= dx, "sNIGHT supply accounting underflow");

  receiveShielded(disclose(coin));

  // The redeemed sNIGHT returns to backing the pool's own reserve. Custody is
  // unchanged; only which side of the invariant claims it moves.
  sNightSupply.write(disclose((supply - dx) as Uint<128>));

  const newPoolBalance: Uint<128> = (poolBalance - dy) as Uint<128>;
  balances.insert(pool, disclose(newPoolBalance));

  reserveNight.write(disclose((x + dx) as Uint<128>));
  reserveAKD.write(disclose((y - dy) as Uint<128>));

  const domainSep: Bytes<32> = persistentHash<Uint<8>>(42);
  const value: Uint<64> = disclose(dy as Uint<64>);
  const out = mintShieldedToken(domainSep, value, disclose(coinNonce()), left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey()));
}
